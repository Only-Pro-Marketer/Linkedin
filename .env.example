# ── Required ──────────────────────────────────────────────────────

# Claude API (get yours at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# LinkedIn OAuth (create an app at https://www.linkedin.com/developers/)
# Enable the products "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback
# w_member_social covers posting, comments and reactions.
# Add r_member_social only if LinkedIn approved your app for it (Community Management API);
# it lets the app read post stats. Without it, add stats by hand in History.
LINKEDIN_SCOPES=openid profile w_member_social

# ── Publishing safety ────────────────────────────────────────────
# Nothing is ever published without your approval. These are extra limits.

POSTING_TIMEZONE=America/Toronto
POSTS_PER_DAY=1
MIN_HOURS_BETWEEN_POSTS=3
ENGAGE_DAILY_CAP=30
# Turn background jobs (research, drafting, publishing approved items) on or off.
SCHEDULER_ENABLED=true

# ── Quality ──────────────────────────────────────────────────────

AUTO_REPAIR=true
FACT_CHECK_ENABLED=true
# Claude-scored experiments. Stays idle until 10 real posts are published.
AUTORESEARCH_ENABLED=false

# ── Optional: research sources ───────────────────────────────────

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linkedin-post-generator/1.0

# AI images for posts. kie.ai is used when its key is set (https://kie.ai/api-key),
# otherwise Gemini (https://aistudio.google.com/apikey).
KIE_API_KEY=
KIE_IMAGE_MODEL=google/nano-banana
KIE_IMAGE_ASPECT=4:5
GEMINI_API_KEY=

# Apify (optional LinkedIn scraping — https://console.apify.com/account/integrations)
# Scraping LinkedIn is against LinkedIn's User Agreement; leave empty to keep it off.
# Everything in the app also works by pasting text.
APIFY_TOKEN=
COMPETITOR_SCRAPE_HOUR=6
COMPETITOR_SCRAPE_ENABLED=true
# Actors used by Engage to fetch a post or its comments (swap them if they stop working).
APIFY_POST_ACTOR=supreme_coder/linkedin-post
APIFY_COMMENTS_ACTOR=apimaestro/linkedin-post-comments-replies-engagements-scraper-no-cookies

# ── Dashboard ────────────────────────────────────────────────────

DATABASE_URL=sqlite:///database/linkedin_posts.db
HOST=127.0.0.1
PORT=8000
# Required if HOST is anything other than 127.0.0.1 / localhost:
DASHBOARD_PASSWORD=
# Session signing key. Leave empty and one is generated in database/.secret_key.
SECRET_KEY=
