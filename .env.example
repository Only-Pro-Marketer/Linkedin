# ── Required ──────────────────────────────────────────────────────

# Claude API (get yours at https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn OAuth (create an app at https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback

# ── Optional: Research Sources ────────────────────────────────────

# Reddit API (for research engine — https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linkedin-post-generator/1.0

# Gemini API (for AI image generation — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Apify (for competitor scraping — https://console.apify.com/account/integrations)
APIFY_TOKEN=
COMPETITOR_SCRAPE_HOUR=6
COMPETITOR_SCRAPE_ENABLED=true

# ── Optional: Your LinkedIn Profile ──────────────────────────────

# Used by the profile scraper to analyze your own post performance
LINKEDIN_PROFILE_URL=

# ── App Settings ─────────────────────────────────────────────────

DATABASE_URL=sqlite:///database/linkedin_posts.db
POSTS_PER_DAY=4
HOST=0.0.0.0
PORT=8000
